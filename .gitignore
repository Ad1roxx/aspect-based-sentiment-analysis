# ---------------------------------------------------------------------------
# ML artifacts
# ---------------------------------------------------------------------------
# MLflow tracking store: regenerated by running training. Large + binary +
# machine-specific absolute paths inside meta.yaml, so it does not belong in Git.
# Reproducibility comes from committed code + params, not from committed runs.
ml/mlruns/
mlruns/
mlartifacts/

# Trained model weights (~250MB per DistilBERT checkpoint). The artifact of
# record lives in the MLflow run, not in Git. Git LFS would be the option if we
# ever needed to version weights directly.
ml/models/
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx

# Raw SemEval-2014 data: third-party licensed, fetched by scripts/download_data.py
# rather than redistributed from this repo.
data/raw/
data/interim/
*.xml.zip

# Hugging Face / torch caches if they ever land inside the repo
.cache/
transformers_cache/

