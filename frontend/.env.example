# Where the FastAPI service lives. Copy to .env.local to override.
#
# Read at BUILD time by Vite, not at runtime, so a production build is pinned to
# whatever this was when `npm run build` ran. That is worth knowing before the
# Docker sprint: the container needs this set at build time, not as a runtime
# environment variable.
VITE_API_URL=http://127.0.0.1:8000
