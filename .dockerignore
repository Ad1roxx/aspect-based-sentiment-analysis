# Everything here would otherwise be copied into the build context. Without this
# file the context is ~10 GB and every build crawls before it even starts.

.git
.github

# Virtualenv — 8.4 GB of CUDA torch, reinstalled inside the image anyway.
.venv/
venv/

# Frontend build inputs/outputs; the frontend image builds these itself.
frontend/node_modules/
frontend/dist/

# Experiment tracking. Regenerated by training, never needed at serving time.
ml/mlruns/
ml/mlartifacts/
ml/mlflow.db
mlruns/
mlartifacts/
ml/reports/

# Raw corpora, fetched by scripts/download_data.py. Training-only.
data/raw/

# Tests, notes and caches
tests/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.coverage
explanations/

# Root-level markdown: docs and working notes. None of it is needed inside the
# image, and excluding the directory-level glob avoids listing filenames here,
# which would publish them in a file that ships with the repo.
/*.md
